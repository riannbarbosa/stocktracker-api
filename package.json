{
  "name": "stocktracker-api",
  "version": "1.0.0",
  "type": "module",
  "description": "REST API serving B3 stock quotes with Redis caching, built to run on containers.",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "JWT_SECRET=test-only-not-a-real-secret node --test \"tests/**/*.test.ts\"",
    "test:watch": "JWT_SECRET=test-only-not-a-real-secret node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "typescript": "5",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.10.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  }
}
